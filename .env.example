# Copy to .env for local overrides. Flask's CLI loads .flaskenv; the app reads the
# variables below from the process environment.

# Port used by `flask run` (also in .flaskenv).
FLASK_RUN_PORT=3001

# SQLAlchemy database URL. Defaults to an absolute sqlite path under data/.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/gym_payments
